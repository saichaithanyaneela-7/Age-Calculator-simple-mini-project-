

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #eaf2f8;
      text-align: center;
      padding: 50px;
    }

    .container {
      background: white;
      padding: 30px;
      max-width: 400px;
      margin: auto;
      border-radius: 10px;
      box-shadow: 0 0 10px #bbb;
    }

    h2 {
      color: #007bff;
    }

    input, button {
      padding: 10px;
      margin: 10px;
      border-radius: 5px;
      border: 1px solid #ccc;
    }

    button {
      background: #007bff;
      color: white;
      border: none;
      cursor: pointer;
    }

    button:hover {
      background: #0056b3;
    }

    #result {
      color: #198754;
      font-size: 18px;
      font-weight: bold;
      margin-top: 20px;
    }

    @media (max-width: 480px) {
      body {
        padding: 20px 10px;
      }

      .container {
        padding: 20px 10px;
      }
    }
  </style>
